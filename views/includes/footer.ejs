<style>
    /* ================================
   FOOTER
================================ */

.footer__section {
    background: linear-gradient(135deg, #111827, #1f2937);
    color: #ffffff;
    padding: 50px 0 !important;
    margin-top: 50px;
    border-top: 3px solid #0d6efd;
}

/* Main footer container */
.footer__section .container {
    max-width: 1200px;
}

/* Main sections */
.footer__section .section {
    gap: 60px;
}

/* Individual section */
.footer__section .sub__section {
    padding: 10px;
}

/* Headings */
.footer__section .section__header {
    font-size: 22px;
    font-weight: 600;
    color: #ffffff;
    position: relative;
    padding-bottom: 10px;
    margin-bottom: 20px !important;
}

/* Heading underline */
.footer__section .section__header::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 45px;
    height: 3px;
    background: #0d6efd;
    border-radius: 5px;
}

/* Labels */
.footer__section .key {
    color: #60a5fa;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 5px !important;
}

/* Text */
.footer__section .value {
    color: #d1d5db;
    font-size: 14px;
    line-height: 1.7;
    text-decoration: none;
    transition: all 0.3s ease;
}

/* Links */
.footer__section a.value {
    display: inline-block;
    width: fit-content;
}

/* Link hover */
.footer__section a.value:hover {
    color: #60a5fa;
    transform: translateX(6px);
}

/* Contact information */
.footer__section .mb-3 {
    margin-bottom: 20px !important;
}

/* Link columns */
.footer__section .row {
    row-gap: 35px;
}

/* Smooth animation */
.footer__section a {
    transition: color 0.3s ease, transform 0.3s ease;
}


/* ================================
   RESPONSIVE DESIGN
================================ */

@media (max-width: 1199px) {

    .footer__section .section {
        gap: 30px;
    }

    .footer__section {
        padding: 40px 20px !important;
    }
}


@media (max-width: 767px) {

    .footer__section {
        padding: 35px 15px !important;
        margin-top: 30px;
    }

    .footer__section .section {
        display: block !important;
    }

    .footer__section .sub__section {
        margin-bottom: 35px;
    }

    .footer__section .section__header {
        font-size: 20px;
    }

    .footer__section .value {
        font-size: 13px;
    }
}


/* ================================
   FOOTER HOVER EFFECT
================================ */

.footer__section .sub__section {
    transition: transform 0.3s ease;
}

.footer__section .sub__section:hover {
    transform: translateY(-3px);
}
</style>



